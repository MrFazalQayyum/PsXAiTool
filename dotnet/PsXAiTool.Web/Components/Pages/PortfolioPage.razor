@page "/portfolio"
@using PsXAiTool.Core.DTOs
@using PsXAiTool.Core.Interfaces
@inject IPortfolioService PortfolioService
@rendermode InteractiveServer

<PageTitle>Portfolio – PSX Intelligence</PageTitle>

<div class="page-header">
    <h1>Portfolio Tracker</h1>
    <button class="btn btn-primary" @onclick="() => _showForm = !_showForm">
        @(_showForm ? "Cancel" : "+ Add Holding")
    </button>
</div>

@if (_showForm)
{
    <div class="panel form-panel">
        <h3>Add New Holding</h3>
        <div class="form-row">
            <input placeholder="Symbol (e.g. ENGRO)" @bind="_newSymbol" />
            <input type="number" placeholder="Shares" @bind="_newShares" />
            <input type="number" step="0.01" placeholder="Avg Buy Price" @bind="_newPrice" />
            <input placeholder="Notes (optional)" @bind="_newNotes" />
            <button class="btn btn-accent" @onclick="AddHolding" disabled="@_saving">
                @(_saving ? "Saving..." : "Add")
            </button>
        </div>
        @if (!string.IsNullOrEmpty(_formError))
        {
            <p class="error">@_formError</p>
        }
    </div>
}

@if (_loading)
{
    <div class="loading-bar">Loading portfolio...</div>
}
else if (_holdings.Count == 0)
{
    <div class="panel">
        <p class="dim">No holdings yet. Add your first position above.</p>
    </div>
}
else
{
    <!-- Summary Row -->
    <div class="card-row">
        <div class="stat-card"><span class="stat-val">@_holdings.Count</span><span class="stat-label">Holdings</span></div>
        <div class="stat-card"><span class="stat-val">PKR @TotalInvested.ToString("N0")</span><span class="stat-label">Invested</span></div>
        <div class="stat-card @(TotalPnL >= 0 ? "up" : "down")">
            <span class="stat-val">@(TotalPnL >= 0 ? "+" : "")@TotalPnL.ToString("N0")</span>
            <span class="stat-label">Total P&L</span>
        </div>
        <div class="stat-card @(TotalPct >= 0 ? "up" : "down")">
            <span class="stat-val">@(TotalPct >= 0 ? "+" : "")@TotalPct.ToString("F2")%</span>
            <span class="stat-label">Return</span>
        </div>
    </div>

    <div class="panel">
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Symbol</th><th>Company</th><th>Shares</th>
                        <th>Avg Buy</th><th>Current</th><th>P&L</th><th>Return</th><th>Notes</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in _holdings)
                    {
                        <tr>
                            <td class="sym">@h.Symbol</td>
                            <td>@h.Name</td>
                            <td>@h.SharesHeld.ToString("N0")</td>
                            <td>@h.AvgBuyPrice.ToString("F2")</td>
                            <td>@(h.CurrentPrice?.ToString("F2") ?? "—")</td>
                            <td class="@(h.PnL >= 0 ? "up" : "down")">
                                @(h.PnL.HasValue ? $"{(h.PnL >= 0 ? "+" : "")}{h.PnL:N0}" : "—")
                            </td>
                            <td class="@(h.PnLPct >= 0 ? "up" : "down")">
                                @(h.PnLPct.HasValue ? $"{(h.PnLPct >= 0 ? "+" : "")}{h.PnLPct:F2}%" : "—")
                            </td>
                            <td class="dim">@(h.Notes ?? "—")</td>
                            <td>
                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteHolding(h.Symbol)">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _showForm;
    private bool _saving;
    private string _newSymbol = "";
    private decimal _newShares;
    private decimal _newPrice;
    private string? _newNotes;
    private string? _formError;
    private List<PortfolioItemDto> _holdings = new();

    private decimal TotalInvested => _holdings.Sum(h => h.AvgBuyPrice * h.SharesHeld);
    private decimal TotalPnL => _holdings.Sum(h => h.PnL ?? 0);
    private decimal TotalPct => TotalInvested > 0 ? TotalPnL / TotalInvested * 100 : 0;

    protected override async Task OnInitializedAsync() => await LoadHoldingsAsync();

    private async Task LoadHoldingsAsync()
    {
        _loading = true;
        _holdings = (await PortfolioService.GetHoldingsAsync()).ToList();
        _loading = false;
    }

    private async Task AddHolding()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_newSymbol)) { _formError = "Symbol is required."; return; }
        if (_newShares <= 0) { _formError = "Shares must be > 0."; return; }
        if (_newPrice <= 0) { _formError = "Price must be > 0."; return; }

        _saving = true;
        try
        {
            await PortfolioService.AddHoldingAsync(new AddPortfolioRequest(_newSymbol.ToUpper(), _newShares, _newPrice, _newNotes));
            _newSymbol = ""; _newShares = 0; _newPrice = 0; _newNotes = null;
            _showForm = false;
            await LoadHoldingsAsync();
        }
        catch (InvalidOperationException ex)
        {
            _formError = ex.Message;
        }
        finally { _saving = false; }
    }

    private async Task DeleteHolding(string symbol)
    {
        await PortfolioService.DeleteHoldingAsync(symbol);
        await LoadHoldingsAsync();
    }
}
