# Root-level env example — see backend/.env.example and frontend/.env.example
# for per-service variables.
#
# Railway: link the Postgres and Redis plugins to each backend service and
# reference their plugin variables directly in the service environment settings.

DATABASE_URL=postgresql://psx_user:psx_password@localhost:5432/psx_intelligence
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=sk-ant-...
FRONTEND_URL=http://localhost:3000
