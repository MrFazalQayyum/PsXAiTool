# ── Database ──────────────────────────────────────────────────────────────────
# Railway: use ${{ Postgres.DATABASE_PRIVATE_URL }}
DATABASE_URL=postgresql://psx_user:psx_password@localhost:5432/psx_intelligence

# ── Redis ─────────────────────────────────────────────────────────────────────
# Railway: use ${{ Redis.REDIS_PRIVATE_URL }}
REDIS_URL=redis://localhost:6379/0

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Railway: set to your nextjs-frontend Railway public URL
FRONTEND_URL=http://localhost:3000

# ── Celery beat schedule (PSX closes 15:30 PKT = 10:30 UTC) ──────────────────
PRICE_FETCH_HOUR_UTC=10
PRICE_FETCH_MINUTE_UTC=45

# ── Email notifications (optional) ────────────────────────────────────────────
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# ── Web Push / VAPID (generate with: python scripts/gen_vapid.py) ─────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com
